* text=auto

# Keep source and project metadata stable across development platforms.
*.cmake text eol=lf
*.cpp text eol=lf
*.dart text eol=lf
*.h text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
CMakeLists.txt text eol=lf

# Binary assets must never be line-ending normalized.
*.ico binary
*.png binary
*.ttf binary
